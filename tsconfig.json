{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "./src",
    "strict": true,
    "paths": {
      "@/*": [
        "*"
      ],
      "tailwind.config": [
        "../tailwind.config.js"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../.expo/types/**/*.ts",
    "../expo-env.d.ts",
    "../nativewind-env.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
